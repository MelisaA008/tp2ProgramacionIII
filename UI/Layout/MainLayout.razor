@inherits LayoutComponentBase

<div class="page">
    <!-- Sidebar con el menú -->
    <div class="sidebar">
        <NavMenu />
    </div>

    <!-- Contenido principal -->
    <main>
        <div class="content px-4">
            @Body
        </div>
    </main>
</div>

<style>
    .page {
        display: flex;
        flex-direction: row;
    }

    .sidebar {
        width: 250px;
        background: linear-gradient(180deg, #556B2F, #6B8E23); /* verde mantra → verde oliva */
        min-height: 100vh;
        color: #fff;
        box-shadow: 2px 0 6px rgba(0,0,0,0.2);
    }


    /* Contenido principal */
    .content {
        flex: 1;
        padding: 20px;
        background-color: #F9FAFB; /* gris claro */
        color: #374151; /* gris piedra para texto */
        border-radius: 8px;
    }
</style>
