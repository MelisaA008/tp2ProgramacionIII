@inherits LayoutComponentBase

<div class="page">
    <!-- Sidebar con el menú -->
    <div class="sidebar">
        <NavMenu />
    </div>

    <!-- Contenido principal -->
    <main>
        <div class="content px-4">
            @Body
        </div>
    </main>
</div>

<style>
    .page {
        display: flex;
        flex-direction: row;
    }

    .sidebar {
        width: 250px;
        background-color: #343a40; /* color oscuro tipo navbar */
        min-height: 100vh;
    }

    .content {
        flex: 1;
        padding: 20px;
    }
</style>
