@page "/home"
@using tp2ProgramacionIII.UI.Components
@inject tp2ProgramacionIII.BL.Services.AuthState AuthState

<h3>Inicio</h3>

@if (AuthState.IsAuthenticated)
{
    <Saludo Nombre="alumno" />
    <p>Usa el menú para navegar.</p>
}
else
{
    <p>No has iniciado sesión. <a href="/login">Ir al login</a></p>
}
