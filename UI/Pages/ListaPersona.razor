@page "/lista-personas"
@using tp2ProgramacionIII.DAL.Models
@inject tp2ProgramacionIII.DAL.Repositories.PersonaRepository PersonaRepo

<h3>Lista de Personas</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Foto</th>
            <th>Nombre Completo</th>
            <th>Email</th>
            <th>Domicilio</th>
            <th>Fecha de Nacimiento</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var persona in PersonaRepo.ObtenerPersonas())
        {
            <tr>
                <td>
                    <img src="@persona.RutaImagen"
                         alt="Foto de @persona.NombreCompleto"
                         width="60" height="60"
                         class="rounded-circle" />
                </td>
                <td>@persona.NombreCompleto</td>
                <td>@persona.Email</td>
                <td>@persona.Domicilio</td>
                <td>@persona.FechaNacimiento.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>
